# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# Build artefacts + machine-local config.
# Listed at the workspace root (in addition to each side's own
# .gitignore) so IDE source-control panels apply them globally — git
# itself reads the nested gitignores, but some VS Code workspaces
# don't traverse them when reporting untracked files.
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/

*.local
*.log

# Environment overrides
.env.local
**/.env.local

# Local reference data. Commit only the Quality workbook needed by the
# dev-quality Excel-backed backend; keep generated caches and other exports out.
backend/data/
*.xlsx
!backend/data/
backend/data/*
!backend/data/Quality_Dashboard_Gold_Layer_3Months.xlsx
!backend/data/gold_mock.xlsx

# Added by code-review-graph
.code-review-graph/
GEMINI.md
AGENTS.md
opencode.jsonc

frontend/.env
.env.backup
.claude/
.mcp.json
CLAUDE.md
backend/.env.bak  
