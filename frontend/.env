# Phase 1 default config (committed). Loaded by Vite for every dev /
# build run unless overridden in .env.local (gitignored).
#
# When the backend comes online in Phase 2, copy this file to
# .env.local and set VITE_USE_MOCK_DATA=false there to switch the
# resource modules to HTTP without changing the committed defaults.

VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_DATA=true
