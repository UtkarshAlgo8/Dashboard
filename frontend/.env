# Phase 1 default config (committed). Loaded by Vite for every dev /
# build run unless overridden in .env.local (gitignored).
#
# Backend lives at ../backend/ since CR-07 (2026-05-27). Resource
# modules in src/api/*.js call HTTP by default. To run on mocks
# (e.g. when the backend is down), create .env.local with
# VITE_USE_MOCK_DATA=true — that overrides this file.

VITE_API_BASE_URL=http://136.112.107.154:8815/api/v1
VITE_USE_MOCK_DATA=false
