# Copy to .env.local to override .env. Never commit .env.local.
# All env vars MUST be prefixed with VITE_ (Vite requirement).

# Phase 1 backend lives at ../backend/ (Node + Express, port 3001).
# See ../backend/README.md to boot it. Q-BE-01 re-resolved by CR-07
# (2026-05-27).

# Backend base URL — appended with endpoint paths.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# "false" (default since CR-07) — resource modules call HTTP.
# "true" — fall back to src/lib/mockData.js with a short artificial
# delay. Useful for offline dev / when the backend is down.
VITE_USE_MOCK_DATA=false

# Auth gate. When true (default) every dashboard route requires a
# signed-in user and the axios client attaches the JWT automatically.
# Flip to "false" only for offline UI work that doesn't touch /api/v1.
VITE_AUTH_ENABLED=true

# Self-hosted SigNoz. Vite variables are PUBLIC and fixed at build time.
VITE_OTEL_ENABLED=false
VITE_OTEL_SERVICE_NAME=jk-dashboard-frontend
# Full OTLP/HTTP trace URL reachable FROM THE USER'S BROWSER.
# Use HTTPS when the dashboard is served over HTTPS.
VITE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
VITE_OTEL_TRACES_SAMPLER_ARG=1
VITE_APP_VERSION=0.0.0
