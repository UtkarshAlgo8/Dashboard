# Copy to .env.local and fill in. Never commit .env.local.
# All env vars MUST be prefixed with VITE_ (Vite requirement).

# Phase 1 = frontend only, dev/localhost only (Q-BE-01, Q-ENV-01 resolved 2026-05-20).
# The backend is deferred to Phase 2; Phase 1 reads from src/lib/mockData.js
# through dummy resource modules at src/api/*.js.

# Backend base URL — appended with endpoint paths. Read by resource
# modules even in Phase 1 so the backend swap is local later.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# "true" (Phase 1 default) — resource modules return mock data with a
# short artificial delay. "false" — resource modules hit HTTP (used
# during Phase 2 backend integration testing only).
VITE_USE_MOCK_DATA=true
