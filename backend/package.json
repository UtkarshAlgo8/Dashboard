{
  "name": "jk-dashboard-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JK Dashboard backend \u2014 Node.js + Express proxy for the upstream gold_dummy data API.",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --watch src/bootstrap.js",
    "start": "node src/bootstrap.js",
    "deploy": "cd .. && git pull origin main && cd backend && (sudo docker ps -q --filter name=jk-dashboard-backend | grep -q . && sudo docker stop jk-dashboard-backend || true) && (sudo docker ps -a -q --filter name=jk-dashboard-backend | grep -q . && sudo docker rm jk-dashboard-backend || true) && (sudo docker images -q jk-dashboard-backend | grep -q . && sudo docker rmi jk-dashboard-backend || true) && sudo docker build -t jk-dashboard-backend . && sudo docker run --restart always -p 8814:8814 --name jk-dashboard-backend -d jk-dashboard-backend",
    "test": "node --test",
    "check:telemetry": "node tools/check-telemetry.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.2.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.208.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/instrumentation": "0.208.0",
    "@opentelemetry/instrumentation-express": "0.57.1",
    "@opentelemetry/instrumentation-http": "0.208.0",
    "@opentelemetry/instrumentation-ioredis": "0.56.0",
    "@opentelemetry/instrumentation-mysql2": "0.55.1",
    "@opentelemetry/instrumentation-runtime-node": "0.22.0",
    "@opentelemetry/instrumentation-undici": "0.19.0",
    "@opentelemetry/instrumentation-winston": "0.53.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.208.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/winston-transport": "0.19.0",
    "alasql": "^4.17.3",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.10.1",
    "sequelize": "^6.37.5",
    "uuid": "^10.0.0",
    "winston": "3.19.0",
    "xlsx": "^0.18.5"
  }
}
