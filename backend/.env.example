# Copy to .env.local and fill in. .env.local is gitignored.

# Upstream data API (AWS Lambda). SELECT/WITH queries only.
AWS_DATA_URL=https://c7hzxcvdxh.execute-api.ap-south-1.amazonaws.com/query
AWS_DATA_API_KEY=REPLACE_ME

# Name passed in the upstream `tables` field AND used as the SQL
# FROM target. Confirmed Postman 2026-05-26: gold_dummy.
AWS_DATA_TABLE=gold_dummy

# Default upstream-call timeout, ms.
AWS_DATA_TIMEOUT_MS=30000

# Express server config.
PORT=3001
# Allowed origin for CORS. Match the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# In-memory cache TTL (ms). Frontend polls every 60s.
CACHE_TTL_MS=30000
