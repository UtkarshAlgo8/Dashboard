# Copy to .env.local and fill in. .env.local is gitignored.

# Upstream gold_bi data API (AWS Lambda).
AWS_DATA_URL=https://c7hzxcvdxh.execute-api.ap-south-1.amazonaws.com/query
AWS_DATA_API_KEY=REPLACE_ME
# Name passed in the upstream `tables` field. Confirmed 2026-05-26:
# table name = gold_bi (single source for Phase 1).
AWS_DATA_TABLE=gold_bi
# Default timeout for upstream calls, ms.
AWS_DATA_TIMEOUT_MS=30000

# Express server config.
PORT=3001
# Allowed origin for CORS. Match the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# In-memory cache TTL (ms). Frontend polls every 60s so 30–60s
# is the sweet spot.
CACHE_TTL_MS=30000
