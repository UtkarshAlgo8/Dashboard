# Copy to .env.local and fill in. .env.local is gitignored.

# Upstream data API (AWS Lambda). SELECT/WITH queries only.
AWS_DATA_URL=https://c7hzxcvdxh.execute-api.ap-south-1.amazonaws.com/query
AWS_DATA_API_KEY=REPLACE_ME

# Upstream query engine: athena (default) | databricks.
AWS_DATA_ENGINE=athena
# Legacy `tables` field, only read by the databricks engine.
AWS_DATA_TABLE=gold_dummy
# SQL FROM target used inside queries. Athena needs schema-qualified gold.gold.
AWS_DATA_SQL_TABLE=gold.gold
# Rolling ~48-day table, complete for today + the last couple of days (where
# AWS_DATA_SQL_TABLE is incomplete) but unreliable further back. Only
# Banmore has one; reads older than GOLD_DAILY_FRESH_DAYS always use
# AWS_DATA_SQL_TABLE instead. See backend/src/queries/gold-source.js.
AWS_DATA_SQL_TABLE_DAILY=gold.gold_daily
# Trailing days (from today, Asia/Kolkata) that count as "fresh" and read
# from AWS_DATA_SQL_TABLE_DAILY instead of AWS_DATA_SQL_TABLE.
GOLD_DAILY_FRESH_DAYS=2

# Default upstream-call timeout, ms.
AWS_DATA_TIMEOUT_MS=30000

# JK KPI Assistant (chatbot) — separate FastAPI service. No API key required.
JK_AGENT_API_URL=http://35.208.174.2:3020
JK_AGENT_TIMEOUT_MS=60000

# Express server config.
PORT=3001
# Allowed origin for CORS. Match the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# In-memory cache TTL (ms). Frontend polls every 60s.
CACHE_TTL_MS=30000

# --- Cache store ---
# "memory" (default) is a Map in this process and is WIPED BY EVERY DEPLOY,
# so the first user after a release re-pays the full upstream cost. "redis"
# keeps the cache across restarts and shares it between containers. Redis is
# optional: if it is unreachable we log once and fall back to memory.
CACHE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
CACHE_KEY_PREFIX=jkdash:
# TTL floor for warmer-written entries. MUST exceed CACHE_WARM_INTERVAL_MS,
# or entries expire between cycles and users still hit a cold cache.
CACHE_WARM_TTL_MS=1500000
# Hard ceiling on the in-process cache (bytes). Applies under BOTH drivers —
# the redis driver mirrors every write into memory, so this is what bounds
# process RSS either way. Measured working set is ~100 MB.
CACHE_MAX_BYTES=201326592

# --- Data materializer ---
# Pulls level-1+2 deduped rows for the trailing window into process
# memory so kpi-data and drill-aggregate serve any filter combination
# without going to Athena. Refresh cadence is the value below; data
# isn't live (shift-grain) so longer than 30 min is fine.
CACHE_MATERIALIZE_ENABLED=true
CACHE_MATERIALIZE_INTERVAL_MS=1800000
CACHE_MATERIALIZE_BOOT_DELAY_MS=5000
CACHE_MATERIALIZE_WINDOW_DAYS=30
CACHE_MATERIALIZE_LEVELS=1,2

# --- Background cache warmer ---
# Refreshes the landing page + each plant's opening dashboard on a timer so
# opening them never waits on the upstream API. Runs once shortly after boot
# (which is what covers the post-deploy cold cache) and then on the interval.
CACHE_WARM_ENABLED=true
CACHE_WARM_INTERVAL_MS=600000
CACHE_WARM_BOOT_DELAY_MS=2000
CACHE_WARM_PLANTS=banmore,chennai
# How many recorded dashboard views to replay per cycle, most-requested first.
CACHE_WARM_MAX_RECORDED=20
# Parallel warm requests. Keep low — firing every target at once risks
# throttling the upstream and timing out the warm it is trying to perform.
CACHE_WARM_CONCURRENCY=2

# --- Quality Dashboard (FRD §A/§B) ---
# "db" (default) runs Quality/SPC SQL through AWS_DATA_URL and AWS_DATA_API_KEY.
# Set "excel" explicitly to use the local reference workbook for fixtures.
QUALITY_DATA_SOURCE=db
# Reference workbook (sheet `result`, 23 columns). Defaults to
# backend/data/Quality_Dashboard_Gold_Layer_3Months.xlsx.
# QUALITY_EXCEL_PATH=
# QUALITY_EXCEL_SHEET=result
# SQL FROM target: alasql table name (excel) / gold table path (upstream).
QUALITY_SQL_TABLE=gold.gold
# Rolling daily counterpart of QUALITY_SQL_TABLE, read for the trailing
# GOLD_DAILY_FRESH_DAYS days exactly as Production does — the base table is
# incomplete for today (2026-09-16: 27 Quality DAY rows in gold.gold vs 61 in
# gold.gold_daily for the same scope). MONTH/YEAR reads always use the base
# table: the rolling table carries no Quality aggregates. Set to "" to
# disable. Ignored by QUALITY_DATA_SOURCE=excel. See
# backend/src/quality/queries/gold-source.js.
QUALITY_SQL_TABLE_DAILY=gold.gold_daily

# --- Auth module ---
# Master kill-switch. AUTH_ENABLED=false leaves every dashboard route
# publicly reachable (handy for local-only dev). Default is true.
AUTH_ENABLED=true
# MySQL connection for the auth DB only. Dashboard data lives in
# AWS (AWS_DATA_URL), so there is no separate data DB to configure.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Auth DB. Created via migrations/2026-09-01-auth-tables.sql.
AUTHDB=authdb
# JWT signing secrets + expiries. Override in production — the
# defaults below are obvious placeholders.
ACCESS_TOKEN_SECRET=change-me-access
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-refresh
REFRESH_TOKEN_EXPIRY=1y
# Where the frontend hosts the password reset page (returned by
# /api/v1/auth/forgot-password alongside the unhashed token).
RESET_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# --- Scheduler Adherence Mail (SMTP) ---
# Daily Infiniti Scheduler mail, sent from the dashboard navbar mail button.
MAIL_FROM=infiniti@example.com
SMTP_USER=REPLACE_ME
# Quote the password if it contains $ or #.
SMTP_PASS='REPLACE_ME'
SMTP_HOST=mail.example.com
SMTP_PORT=587
# true = implicit TLS (port 465). false = plain connection, upgraded with
# STARTTLS when the server offers it.
SMTP_SECURE=false
# true = refuse to send unless STARTTLS succeeds.
SMTP_REQUIRE_TLS=false
# Recipients. Production: the one main recipient in MAIL_TO, everyone else
# in MAIL_CC (comma-separated). Send is disabled while MAIL_TO is empty.
MAIL_TO=
MAIL_CC=
# Optional: comma-separated roles allowed to send. Empty = any signed-in user.
MAIL_SEND_ROLES=
# Optional: domains the pop-up's "Custom" recipients may use, e.g.
# algo8.ai,jkmail.com. Empty = any domain.
MAIL_CUSTOM_ALLOWED_DOMAINS=
# Where the 9 Curing values come from. "snapshot" (default, TEMPORARY) reads
# only the static extract below, skipping the gold query, which returns nothing
# for these KPIs today. "gold" reads gold first, the extract for missing values.
MAIL_KPI_SOURCE=snapshot
# Backend copy of frontend/public/temp/curing-sku-fulfilment.json.
# Defaults to backend/data/curing-sku-fulfilment.json.
# MAIL_KPI_SNAPSHOT_PATH=
# How long the values for a report day are reused (ms).
MAIL_KPI_CACHE_TTL_MS=300000
